# Valores do build de produção (o site publicado na Vercel). Num build feito no próprio computador,
# este arquivo vale mais que o .env.local; só um .env.production.local passa por cima dele.
#
# A API fica no mesmo domínio do site: o vercel.json repassa /api pro projeto da API, então o
# navegador nunca fala com outro domínio e o cookie do login funciona.
VITE_API_URL=/api
VITE_USAR_EXEMPLOS=false
VITE_LINK_API_DOCS=/api/docs
VITE_LINK_GITHUB=https://github.com/LucasAlbq/urbanlink-flow
